{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"$HOME\"/.agent-exporter-to-langfuse/config/claude-code.env 2>/dev/null; cd \"${CLAUDE_PLUGIN_ROOT}\"/hooks/ && uv run python langfuse_hook.py",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"$HOME\"/.agent-exporter-to-langfuse/config/claude-code.env 2>/dev/null; cd \"${CLAUDE_PLUGIN_ROOT}\"/hooks/ && uv run python langfuse_hook.py",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
